{
  // wknipe.com: the Quarto site in _site/, served as a Cloudflare Worker with static assets (no code).
  // Build: ~/.local/quarto/bin/quarto render   Deploy: npx wrangler deploy (from site/)
  "$schema": "../apps/x402-index-api/node_modules/wrangler/config-schema.json",
  "account_id": "0134a2c1c491457155b6aa9d6c79a8ae", // public account id (not a secret); lets CI deploy without an extra secret
  "name": "wknipe",
  "compatibility_date": "2026-09-29",
  "assets": { "directory": "./_site", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "wknipe.com", "custom_domain": true }]
}
