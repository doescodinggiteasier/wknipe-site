# Build output and dependencies
node_modules/
.wrangler/
site/_site/
site/.quarto/
site/x402/data/
site/x402_index/
apps/x402-index-api/src/data.json
__pycache__/
.venv/
*_files/
# Paper build output (`cd paper && quarto render`); its generated inputs (_numbers.yml, tables, fig/) are committed because
# Quarto resolves includes before the pre-render step. They are pinned to the paper's weeks, so they don't churn.
paper/_output/
# Raw collected weeks (hundreds of MB); CI keeps an unfinished one in the Actions cache only
state/x402_week_*/
# Never commit secrets or private working files
.env
.env.*
local/
predictions/private/
.DS_Store

# ORDER_013: generated at render by site/_pages.py / _pages4.py (never edit by hand)
site/_gen/
site/badges/seller/
site/badges/status/
site/weekly/20??-??-??.qmd
site/assets/search-*.json
site/assets/glossary.json
site/x402/sellers/0x*.qmd
# daily price map baseline lives in the Actions cache
state/bazaar_daily/
site/x402/prices/changes.xml
